# Servidor Node.js 22.18+
NODE_ENV=development
PORT=3000
# Gere pelo menos 32 caracteres aleatórios; não há segredo padrão.
JWT_SECRET=
# Origem pública fixa, usada para gerar links de recuperação. HTTPS em produção.
APP_URL=https://verfica-fato-ifpr.vercel.app
# Recuperação por e-mail: Resend Free (3.000/mês, até 100/dia).
# Sem esta configuração o recurso responde 503 com orientação explícita.
RECOVERY_EMAIL_PROVIDER=resend
# Para enviar a outros usuários, verifique um domínio próprio no Resend.
RESEND_API_KEY=
# Remetente verificado no provedor, opcionalmente "VerificaFato <endereço>".
RECOVERY_EMAIL_FROM=
# Obrigatório para contas, histórico e administração; opcional para análise anônima.
MONGO_URI=
MONGO_DB_NAME=verificafato
MONGO_COLLECTION=noticias_coletadas
# Origens exatas separadas por vírgula, além da mesma origem.
APP_ORIGINS=
# Habilite apenas com exatamente um proxy reverso confiável.
TRUST_PROXY=0

# Chave somente no backend. Habilite Fact Check Tools API no projeto Google.
GOOGLE_API_KEY=
# Opcional: substitui a lista padrão de domínios reconhecidos.
# FACT_CHECK_TRUSTED_DOMAINS=aosfatos.org,lupa.uol.com.br,agencialupa.org,boatos.org,estadao.com.br,g1.globo.com,afp.com,reuters.com,apnews.com,factcheck.org,politifact.com,fullfact.org

# Explicação por IA externa (opcional; desativada por padrão).
# Gemini é o provedor preferencial. Não reutilize GOOGLE_API_KEY aqui:
# Fact Check Tools e Gemini têm configurações e finalidades separadas.
ENABLE_AI_EXPLANATION=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Informe um identificador disponível na sua conta com saída estruturada.
# Nenhum modelo é escolhido automaticamente por este exemplo.
# A mesma chamada produz o comentário e a seleção opcional de Contexto Jurídico.
# HTTP 503 indica indisponibilidade do provedor; a aplicação não simula resposta.
# A base jurídica revisada fica em data/legal-catalog.json; não exige outra API/chave.
GEMINI_MODEL=

# Alternativa compatível: mude AI_PROVIDER para openai para usar estas variáveis.
OPENAI_API_KEY=
# Informe um modelo da sua conta que suporte Responses API e Structured Outputs.
OPENAI_MODEL=

# Opcional: diretório local de modelo avaliado, com model-card.json, vocab.json,
# model.json e shards de pesos. Não baixa modelos automaticamente.
TFJS_MODEL_DIR=
